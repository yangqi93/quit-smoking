# 服务端口
PORT=8080

# MySQL 数据库配置（Docker 部署时 DB_HOST 填宿主机 IP）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=quit_smoking

# JWT 密钥（生产环境务必更换）
JWT_SECRET=quit-smoking-secret-change-in-prod

# 微信小程序配置（从微信公众平台 → 开发管理 → 开发设置 获取）
WX_APP_ID=your_appid_here
WX_APP_SECRET=your_secret_here

# 运行环境: development / production
ENV=development
