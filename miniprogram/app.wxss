/* 全局样式 - 戒烟助手深色主题 */
page {
  background-color: #0f0f1a;
  color: #e8e8f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: linear-gradient(135deg, #1e1e3a, #2a2a4a);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.card-title {
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 16rpx;
}

/* 强调色 */
.text-primary {
  color: #4ecdc4;
}

.text-accent {
  color: #ff6b6b;
}

.text-warning {
  color: #ffd93d;
}

.text-success {
  color: #6bff9e;
}

/* 大数字 */
.big-number {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #4ecdc4;
  text-shadow: 0 0 40rpx rgba(78, 205, 196, 0.3);
}

.big-number-unit {
  font-size: 32rpx;
  color: #8888aa;
  margin-left: 8rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4ecdc4, #2ecc71);
  color: #0f0f1a;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-danger {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #8888aa;
  border: 2rpx solid #3a3a5a;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #2a2a4a;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4ecdc4, #6bff9e);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #2a2a4a;
  margin: 24rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-success {
  background: rgba(107, 255, 158, 0.15);
  color: #6bff9e;
}

.tag-warning {
  background: rgba(255, 217, 61, 0.15);
  color: #ffd93d;
}

.tag-danger {
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
}
