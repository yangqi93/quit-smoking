/* ============================================
   主题色彩变量
   策略: page 处理系统自动深色, .root 处理手动覆盖
   ============================================ */

/* ─── 浅色默认（page 级） ──────────────────── */
page {
  --bg-primary: #f5f5fa;
  --bg-card: #ffffff;
  --bg-elevated: #eeeef5;
  --bg-tertiary: #e8e8f0;
  --text-primary: #1a1a2e;
  --text-secondary: #666688;
  --text-tertiary: #9999bb;
  --border: #d0d0dd;
  --border-light: #e5e5f0;
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ─── 系统深色自动适配 ────────────────────── */
@media (prefers-color-scheme: dark) {
  page {
    --bg-primary: #0f0f1a;
    --bg-card: linear-gradient(135deg, #1e1e3a, #2a2a4a);
    --bg-elevated: #2a2a4a;
    --bg-tertiary: #1a1a2e;
    --text-primary: #e8e8f0;
    --text-secondary: #8888aa;
    --text-tertiary: #666688;
    --border: #3a3a5a;
    --border-light: #2a2a4a;
    --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  }

  /* 深色背景下高亮色用荧光版本 */
  .text-success { color: #6bff9e; }
  .text-warning { color: #ffd93d; }
  .tag-success { background: rgba(107, 255, 158, 0.15); color: #6bff9e; }
  .tag-warning { background: rgba(255, 217, 61, 0.15); color: #ffd93d; }
}

/* ─── 手动覆盖（.root 级，比 page 特异性高） ── */

/* 手动深色 */
.root.theme-dark {
  --bg-primary: #0f0f1a;
  --bg-card: linear-gradient(135deg, #1e1e3a, #2a2a4a);
  --bg-elevated: #2a2a4a;
  --bg-tertiary: #1a1a2e;
  --text-primary: #e8e8f0;
  --text-secondary: #8888aa;
  --text-tertiary: #666688;
  --border: #3a3a5a;
  --border-light: #2a2a4a;
  --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* 手动深色下高亮色恢复荧光版本 */
.root.theme-dark .text-success { color: #6bff9e; }
.root.theme-dark .text-warning { color: #ffd93d; }
.root.theme-dark .tag-success { background: rgba(107, 255, 158, 0.15); color: #6bff9e; }
.root.theme-dark .tag-warning { background: rgba(255, 217, 61, 0.15); color: #ffd93d; }

/* 手动浅色（覆盖系统深色） */
.root.theme-light {
  --bg-primary: #f5f5fa;
  --bg-card: #ffffff;
  --bg-elevated: #eeeef5;
  --bg-tertiary: #e8e8f0;
  --text-primary: #1a1a2e;
  --text-secondary: #666688;
  --text-tertiary: #9999bb;
  --border: #d0d0dd;
  --border-light: #e5e5f0;
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* ============================================
   页面根容器（继承 page 变量，承载手动类）
   ============================================ */
.root {
  min-height: 100vh;
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(12rpx);
}

.container.page-visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.35s ease-out, transform 0.35s ease-out;
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

/* 强调色（两套主题通用） */
.text-primary, .text-accent-teal {
  color: #4ecdc4;
}

.text-accent {
  color: #ff6b6b;
}

.text-warning {
  color: #c0392b;
}

.text-success {
  color: #1e8c5e;
}

/* 大数字 */
.big-number {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #4ecdc4;
  text-shadow: 0 0 40rpx rgba(78, 205, 196, 0.3);
}

.big-number-unit {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-left: 8rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4ecdc4, #2ecc71);
  color: #0f0f1a;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  position: relative;
  overflow: hidden;
}

.btn-primary::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s, opacity 0.6s;
}

.btn-primary:active::after {
  width: 600rpx;
  height: 600rpx;
  opacity: 0;
}

.btn-danger {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: var(--bg-elevated);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4ecdc4, #6bff9e);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border-light);
  margin: 24rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-success {
  background: rgba(30, 140, 94, 0.12);
  color: #1e8c5e;
}

.tag-warning {
  background: rgba(192, 57, 43, 0.1);
  color: #c0392b;
}

.tag-danger {
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
}
