/* pages/breathe/breathe.wxss */

.breathe-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

/* 触发场景 */
.trigger-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  text-align: center;
}

.trigger-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.trigger-item {
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  background: var(--bg-elevated);
  color: var(--text-secondary);
  font-size: 26rpx;
  transition: all 0.3s;
}

.trigger-selected {
  background: rgba(78, 205, 196, 0.2);
  color: #4ecdc4;
  border: 2rpx solid #4ecdc4;
}

/* 呼吸圈容器 */
.breath-circle-container {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 60rpx 0;
  width: 400rpx;
  height: 400rpx;
}

/* 背景呼吸涟漪 */
.breath-bg-glow {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  filter: blur(24rpx);
  opacity: 0.4;
  transition: all 4s ease-in-out;
  animation: breath-bg-pulse 4s ease-in-out infinite alternate;
}

@keyframes breath-bg-pulse {
  0% { transform: scale(0.85); opacity: 0.25; }
  50% { transform: scale(1.15); opacity: 0.45; }
  100% { transform: scale(0.85); opacity: 0.25; }
}

/* 呼吸圈 */
.breath-circle {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(78, 205, 196, 0.3), rgba(78, 205, 196, 0.05));
  border: 4rpx solid rgba(78, 205, 196, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 4s ease-in-out, opacity 1s ease, border-color 1s ease, box-shadow 1s ease;
  box-shadow: 0 0 80rpx rgba(78, 205, 196, 0.2);
  z-index: 1;
}

.breath-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.countdown-number {
  font-size: 96rpx;
  font-weight: 700;
  color: #4ecdc4;
  line-height: 1;
  margin-bottom: 12rpx;
}

.phase-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.phase-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 20rpx;
}

/* 轮次进度 */
.rounds-progress {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 30rpx;
}

/* 操作按钮 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.breathe-start-btn {
  width: 400rpx;
  margin-top: 20rpx;
}

/* 方法说明 */
.method-desc {
  width: 100%;
  margin-top: 40rpx;
}

.method-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.step-num {
  font-weight: 700;
  min-width: 80rpx;
}

.method-note {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-light);
}
