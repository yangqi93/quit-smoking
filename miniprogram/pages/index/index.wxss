/* pages/index/index.wxss */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 60rpx;
  text-align: center;
}

/* 计时器卡片 */
.timer-card {
  text-align: center;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.encouragement {
  font-size: 28rpx;
  color: #4ecdc4;
  margin-bottom: 36rpx;
}

/* 环形进度圈容器 */
.progress-ring-container {
  position: relative;
  width: 340rpx;
  height: 340rpx;
  margin: 0 auto 24rpx;
}

/* 光环 */
.progress-ring-glow {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  border-radius: 50%;
  background: conic-gradient(
    rgba(78, 205, 196, 0.15) 0deg,
    rgba(78, 205, 196, 0.15) var(--progress, 0deg),
    transparent var(--progress, 0deg)
  );
  animation: glow-pulse 3s ease-in-out infinite;
}

@keyframes glow-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* 环形进度 */
.progress-ring {
  position: relative;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: conic-gradient(
    #4ecdc4 0deg,
    #4ecdc4 var(--progress, 0deg),
    var(--bg-elevated) var(--progress, 0deg),
    var(--bg-elevated) 360deg
  );
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 60rpx rgba(78, 205, 196, 0.12), inset 0 0 30rpx rgba(78, 205, 196, 0.06);
}

/* 内圈（遮出环形效果） */
.progress-ring-inner {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-primary));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 16rpx rgba(0, 0, 0, 0.15), 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 环形内大数字 */
.ring-big-number {
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1;
  color: #4ecdc4;
  text-shadow: 0 0 40rpx rgba(78, 205, 196, 0.35);
}

.ring-unit {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 时间细节 */
.timer-sub-detail {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.sub-detail-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.sub-detail-divider {
  color: var(--border);
}

/* 统计双卡 */
.stats-row {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

/* 重获生命 */
.life-value {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

/* 里程碑 */
.milestone-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.milestone-name {
  font-size: 28rpx;
  color: #4ecdc4;
  font-weight: 600;
}

.milestone-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.emergency-btn, .checkin-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
}
