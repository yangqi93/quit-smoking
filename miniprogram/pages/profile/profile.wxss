/* pages/profile/profile.wxss */

/* 用户信息卡 */
.user-info-card {
  padding: 36rpx 30rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

/* 头像按钮重置样式 */
.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  width: auto;
  height: auto;
  font-size: 0;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #4ecdc4;
  display: block;
}

.user-avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #4ecdc4;
  background: #2a2a4a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-default-icon {
  font-size: 56rpx;
}

.user-info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8e8f0;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  width: 100%;
  height: auto;
  line-height: 1.3;
}

.nickname-placeholder {
  color: #5a5a7a;
  font-weight: 400;
}

.user-days-text {
  font-size: 26rpx;
  color: #8888aa;
  margin-top: 4rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #2a2a4a;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #8888aa;
}

.info-value {
  font-size: 28rpx;
  color: #e8e8f0;
}

.reason-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.reason-text {
  font-size: 26rpx;
  color: #aaaacc;
  line-height: 1.6;
}

/* 复吸卡片 */
.relapse-card {
  border: 2rpx solid rgba(255, 107, 107, 0.2);
}

.relapse-desc {
  font-size: 26rpx;
  color: #8888aa;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 开始表单 */
.start-form {
  padding-top: 20rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #1a1a2e;
  border: 2rpx solid #3a3a5a;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #e8e8f0;
  font-size: 30rpx;
}

.form-input:focus {
  border-color: #4ecdc4;
}

.picker-input {
  cursor: pointer;
}

.form-textarea {
  background: #1a1a2e;
  border: 2rpx solid #3a3a5a;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #e8e8f0;
  font-size: 28rpx;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}

.confirm-btn {
  margin-top: 30rpx;
  width: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}
