/* pages/profile/profile.wxss */

/* 用户信息卡 */
.user-info-card {
  padding: 36rpx 30rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

/* 头像按钮重置样式 */
.avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  width: auto;
  height: auto;
  font-size: 0;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #4ecdc4;
  display: block;
}

.user-avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #4ecdc4;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-default-icon {
  font-size: 56rpx;
}

.user-info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  width: 100%;
  height: auto;
  line-height: 1.3;
}

.nickname-placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}

.user-days-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-light);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.reason-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.reason-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 复吸卡片 */
.relapse-card {
  border: 2rpx solid rgba(255, 107, 107, 0.2);
}

.relapse-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 开始表单 */
.start-form {
  padding-top: 20rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--text-primary);
  font-size: 30rpx;
}

.form-input:focus {
  border-color: #4ecdc4;
}

.picker-input {
  cursor: pointer;
}

.form-textarea {
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}

.confirm-btn {
  margin-top: 30rpx;
  width: 100%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

/* ─── 成就徽章墙 ─────────────────────────── */
.achievements-card {
  padding-bottom: 20rpx;
}

.achievement-summary {
  margin-bottom: 20rpx;
}

.achievement-count {
  font-size: 40rpx;
  font-weight: 700;
}

.achievement-total {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 网格：每行4个 */
.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.achievement-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

/* 已解锁：高亮 + 呼吸光效 */
.achievement-item.unlocked {
  background: rgba(78, 205, 196, 0.1);
  border-color: rgba(78, 205, 196, 0.3);
  animation: badge-glow 3s ease-in-out infinite;
}

@keyframes badge-glow {
  0%, 100% {
    box-shadow: 0 0 8rpx rgba(78, 205, 196, 0.2);
  }
  50% {
    box-shadow: 0 0 20rpx rgba(78, 205, 196, 0.5), 0 0 40rpx rgba(78, 205, 196, 0.15);
  }
}

/* 未解锁：灰暗 */
.achievement-item.locked {
  background: var(--bg-elevated);
  border-color: var(--border-light);
  opacity: 0.5;
}

.achievement-icon {
  font-size: 48rpx;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.achievement-name {
  font-size: 20rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.3;
  word-break: keep-all;
}

.achievement-item.unlocked .achievement-name {
  color: var(--text-primary);
}

/* ─── 成就庆祝弹窗 ───────────────────────── */
.achievement-popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: maskFadeIn 0.3s ease;
}

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.achievement-popup {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  width: 580rpx;
  text-align: center;
  border: 2rpx solid rgba(78, 205, 196, 0.4);
  box-shadow: 0 0 60rpx rgba(78, 205, 196, 0.25);
  animation: popupBurst 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

@keyframes popupBurst {
  0% {
    opacity: 0;
    transform: scale(0.3) rotate(-5deg);
  }
  60% {
    opacity: 1;
    transform: scale(1.05) rotate(1deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

/* 星星粒子 — 用多个伪元素模拟 */
.achievement-popup::before,
.achievement-popup::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.achievement-popup::before {
  width: 12rpx;
  height: 12rpx;
  background: #ffd93d;
  top: 30rpx;
  right: 60rpx;
  animation: particle-star 1.2s ease-out infinite;
  box-shadow: 0 0 8rpx #ffd93d;
}

.achievement-popup::after {
  width: 8rpx;
  height: 8rpx;
  background: #4ecdc4;
  bottom: 50rpx;
  left: 40rpx;
  animation: particle-star 1.2s ease-out 0.4s infinite;
  box-shadow: 0 0 6rpx #4ecdc4;
}

@keyframes particle-star {
  0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
  40% {
    opacity: 0.8;
    transform: translate(-30rpx, -50rpx) scale(2);
  }
  100% {
    opacity: 0;
    transform: translate(-60rpx, -100rpx) scale(0);
  }
}

.popup-sparkle {
  font-size: 48rpx;
  margin-bottom: 10rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.popup-icon {
  font-size: 100rpx;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.popup-title {
  font-size: 24rpx;
  color: #4ecdc4;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 10rpx;
}

.popup-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.popup-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.popup-close {
  display: inline-block;
  background: linear-gradient(135deg, #4ecdc4, #2ecc71);
  color: #0f0f1a;
  border-radius: 48rpx;
  padding: 18rpx 60rpx;
  font-size: 30rpx;
  font-weight: 600;
}
