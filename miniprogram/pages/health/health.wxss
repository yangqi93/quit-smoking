/* pages/health/health.wxss */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 进度卡片 */
.progress-card {
  margin-bottom: 30rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: 700;
}

.progress-stats {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  text-align: center;
}

/* 时间线 */
.timeline-list {
  padding-left: 10rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

/* 仅首次加载播入场动画，避免切换Tab时节点抖动 */
.animating .timeline-item {
  opacity: 0;
  transform: translateY(20rpx);
  animation: item-fade-in 0.5s ease-out forwards;
}

.animating .timeline-item:nth-child(1) { animation-delay: 0.05s; }
.animating .timeline-item:nth-child(2) { animation-delay: 0.10s; }
.animating .timeline-item:nth-child(3) { animation-delay: 0.15s; }
.animating .timeline-item:nth-child(4) { animation-delay: 0.20s; }
.animating .timeline-item:nth-child(5) { animation-delay: 0.25s; }
.animating .timeline-item:nth-child(6) { animation-delay: 0.30s; }
.animating .timeline-item:nth-child(7) { animation-delay: 0.35s; }
.animating .timeline-item:nth-child(8) { animation-delay: 0.40s; }
.animating .timeline-item:nth-child(9) { animation-delay: 0.45s; }
.animating .timeline-item:nth-child(10) { animation-delay: 0.50s; }
.animating .timeline-item:nth-child(11) { animation-delay: 0.55s; }
.animating .timeline-item:nth-child(12) { animation-delay: 0.60s; }
.animating .timeline-item:nth-child(13) { animation-delay: 0.65s; }
.animating .timeline-item:nth-child(14) { animation-delay: 0.70s; }
.animating .timeline-item:nth-child(15) { animation-delay: 0.75s; }

@keyframes item-fade-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.timeline-item:last-child {
  padding-bottom: 0;
}

/* 节点 */
.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.node-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 已达成节点发光 + 弹性缩放 */
.dot-achieved {
  background: #4ecdc4;
  box-shadow: 0 0 16rpx rgba(78, 205, 196, 0.6), 0 0 32rpx rgba(78, 205, 196, 0.2);
  animation: dot-glow 2s ease-in-out infinite, dot-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s both;
}

@keyframes dot-glow {
  0%, 100% { box-shadow: 0 0 16rpx rgba(78, 205, 196, 0.6), 0 0 32rpx rgba(78, 205, 196, 0.2); }
  50% { box-shadow: 0 0 24rpx rgba(78, 205, 196, 0.9), 0 0 48rpx rgba(78, 205, 196, 0.35); }
}

@keyframes dot-pop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 未达成节点 */
.dot-pending {
  background: var(--bg-elevated);
  border: 3rpx solid var(--border);
}

.node-line {
  width: 4rpx;
  flex-grow: 1;
  margin-top: 8rpx;
}

.line-achieved {
  background: linear-gradient(180deg, #4ecdc4, rgba(78, 205, 196, 0.3));
  animation: line-fill 0.6s ease-out both;
}

@keyframes line-fill {
  from { opacity: 0; }
  to { opacity: 1; }
}

.line-pending {
  background: var(--bg-tertiary);
}

/* 内容 */
.timeline-content {
  flex: 1;
  padding: 12rpx 20rpx 12rpx 0;
}

.milestone-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.milestone-title {
  font-size: 30rpx;
  font-weight: 600;
}

.milestone-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.milestone-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.milestone-category {
  padding: 4rpx 16rpx;
  background: var(--bg-elevated);
  border-radius: 16rpx;
  font-size: 20rpx;
}

/* 已达成项 —— 高亮且有弹性动画 */
.timeline-item.achieved .milestone-title {
  color: #1e8c5e;
}

.timeline-item.achieved .milestone-desc {
  color: var(--text-primary);
}

.timeline-item.achieved .milestone-category {
  background: rgba(78, 205, 196, 0.15);
  color: #4ecdc4;
}

.timeline-item.achieved .tag-success {
  animation: tag-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s both;
}

@keyframes tag-pop {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 未达成项 —— 灰阶 */
.timeline-item.pending .milestone-title {
  color: var(--text-tertiary);
}

.timeline-item.pending .milestone-desc {
  color: var(--text-tertiary);
}

.timeline-item.pending .milestone-category {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

/* ============================================
   深色主题：里程碑标题高亮色恢复荧光版本
   ============================================ */
@media (prefers-color-scheme: dark) {
  .timeline-item.achieved .milestone-title { color: #6bff9e; }
}

.root.theme-dark .timeline-item.achieved .milestone-title { color: #6bff9e; }
